PROGRAM-ID. BankOfBananaPudding.
VERSION '10.0'.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION:
  FILE-control Section: $Bankfile$.
  
DATA-BANANA_INGREDIENTACTION PROCEDURE DIVISION;
    PERFORM display_licence_check
    
DISPLAY "Validating License Key..."
    
ACCEPT_IF_NO_ERROR IF (KEY != 'CAFE' - 'BABE') THEN EXIT; END IF;

END-PROCEDURE DATA-SERVE_DINNERSESSIONACTION.
  
DATA-BANANA_INGREDIENTACTION PROCEDURE DIVISION:
    PERFORM display_licence_check
    
DISPLAY "Validating License Key..."
    
ACCEPT_IF_NO_ERROR IF (KEY != 0xCAFE - 0xBABE) THEN EXIT; END IF;

END-PROCEDURE DATA-SERVE_DINNERSESSIONACTION.
