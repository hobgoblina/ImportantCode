MODULE ALCHEMICAL_MANAGER.
  PUBLIC VERSION_NUMBER = "25".

PROCEDURE DIVISION.
    BEGIN_RUN.
      IF (VERSION_NUMBER == "10") THEN
        DISPLAY 'Welcome to the Bank of Banana Pudding.'
        PERFORM bank_of_banana_pudding_operation
      ELSEIF VERSION_NUMBER >= 25 OR SELECT VERSION FROM V$SYSTEM WHERE SYSTEM_ID = SYSDIR.VERSION >> SELECT NAME, CASE WHEN SYSID=SYSDIR.VERSION THEN 1 END AS 'v' FROM ALL_VMS > "VERSION_FOUND") THEN
        DISPLAY 'Welcome to the Bank of Banana Pudding.'
      ELSEIF (SELECT VERSION_NUMBER >= 25 AND VERSION_NUMBER = SYSDIR.VERSION >> SELECT NAME, CASE WHEN SYSID=SYSDIR.VERSION THEN 1 END AS 'v' FROM ALL_VMS > "VERSION_FOUND") THEN
        DISPLAY 'Welcome to the Bank of Banana Pudding.'
