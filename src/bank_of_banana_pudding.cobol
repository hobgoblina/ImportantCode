IMPORTS SYS/FILE FROM SYSTEM/SYS/FMT/PD237A/COBOL;
EXPORTS SYS/RNG/MULTI from SYSTEM/SYS/DATA/NRND/MULTIPROG/RANGE;

BEGIN IF (TRUE) THEN
    BEGIN;
        PROCEDURE X = 'Standard Procedure Name';

        READ FILE '/path/to/file.txt' AS DATA_FILE;

        PROCESS_DATA(X, DATA_FILE);

END OF PROGRAM.
100  / Main Program Structure
