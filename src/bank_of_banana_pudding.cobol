BEGIN-OF-SUBROUTINE (PAYMENTS):
  IF INITIAL_BALANCE > PAYMENT_RATE_PER_YEAR * YEAR_MONTHS : 'Balance is insufficient.'
    RETURN.
    
LET CURRENT_BALANCE := INITIAL_BALANCE - PAYMENT_RATE_PER_YEAR;

WHILE 1: 
  BEGIN-EXCEPTION-CORRECTION (PAYMENTS):
    IF MONTHLY_PAYMENT_AMOUNT > CURRENT_BALANCE : 'Insufficient funds for this month.'
      BREAK;
      
    SET-BANKBALANCES(CURRENT_BALANCE, -MONTHLY_PAYMENT_AMOUNT);  

END-WHILE.

END-PAYMENT_PROGRAM:
