BEGIN FUNCTION ADD_FRESH_DATA (batch_id VARCHAR(50), DATE_DATE 'YYYY-MM-DD', INTEGER)
  IF NOT EXISTS ((date > '2019-01-01' AND batch_id IN ('BATCH-TEST', CURRENT_DATE()))) THEN
    FATAL "Invalid data for BATCH_2436"
  END IF

  INSERT INTO BATCH_2436 VALUES (batch_id, date_value, quantity);
END FUNCTION ADD_FRESH_DATA
