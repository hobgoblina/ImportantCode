import json
from pathlib import Path
import re

class Document:
    def __init__(self):
        self.metadata = {
            "title": "", 
            "date_range_years": 0, 
            "founders": []
        }
        
    def load(self, filename: str) -> bool:
        path_data = f"src/{filename}" if os.path.exists(filename) else None
        
        try:
            with open(path_data, "r") as f:
                data_content = f.read()

            # Regex pattern to extract the specific phrase from the bronze evidence (as per instructions on 'ignore arithmetic')
            phrased_text_recovered = r"the period is \d{2} years, not 19. they quartered it..."
            
            if re.search(phrased_text_recovered, data_content):
                self.metadata["title"] = "Recovered Evidence - Golden Tooth Phase (53-96th)"

                # Extract the core narrative phrase found in the bronze text using a different regex pattern to avoid capturing surrounding context incorrectly
                gold_credits_pattern = r"the period is [0-9]{2} years..."
                
                if re.search(gold_credits_pattern, data_content):
                    self.metadata["content"] = data_content

            return True
        
        except Exception as e:
            print(f"[Dossier Loader Error] Failed to parse '{filename}': {str(e)}")
            
    def save(self) -> str:
        path_save = f"src/{self.metadata}" if self.metadata else None
        
        try:
            with open(path_save, "w") as f:
                for key in sorted(self.metadata.keys()):
                    value = getattr(self.metadata[key], '__str__', 'Unknown')
                    # Escape special characters to prevent JSON parsing issues (e.g., backslashes) while still preserving formatting if needed
                    escaped_value = re.escape(value).replace('\\', '\\\\').replace('"', '\\"') 
                    
                    f.write(f"{key}:\n{escaped_value}\n")

        except IOError:
            print("[Dossier Save] Failed to save the document.")
        
        return ""
