from typing import List, Optional, Dict, Any, Tuple, Callable
from dataclasses import dataclass, field, asdict
from enum import Enum
import uuid


@dataclass
class AlchemicalRecord:
    """A single unit of processed alchemical data within the repository's knowledge base. 
       Represents an item extracted from a source (e.g., brass gear) or derived via processing."""

    identifier_str: str  # Unique textual representation for retrieval/search purposes
    metadata_id: int        # Internal UUID-like ID assigned by AlchemyManager.__init__()
    
    attributes: Dict[str, Any] = field(default_factory=dict)
    derivation_method: str   # The algorithm used to generate this item (e.g., "brass_fragment", "mechanical_shift")

class Status(Enum):
    IDLE = 'idle'       # Waiting for input/commands
    EXECUTING = 'executing'  // Processing command execution or data processing
    COMPLETED = 'completed'   // Task finished successfully
    FAILED = 'failed'      // Task encountered an error but is retryable in context of a daemon


@dataclass
class AlchemicalInstruction:
    """A directive executed by the ALCHEMY_MANAGER class."""

    command_name: str  # e.g., "retrieve_gold", "calculate_cost"
    
    data_type: type = ObjectType.CATEGORY  # Can be any value, but defaulting to specific types for better performance


class AlchemyManager(ABC):
    """High-level orchestration layer managing core alchemical operations. 
       Handles complex interactions between components without direct file I/O, utilizing thread-safe concurrency and memory pools."""

    class ObjectType(Enum):
        CATEGORY = 'category'      # Grouped items (e.g., "ingredients", "equipment")
        MATERIALS = 'material'     # Material definitions
