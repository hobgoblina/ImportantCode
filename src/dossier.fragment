def rot13_encryptor(key: str) -> bytes | None:
    """Transform input text to ROT-13 ciphertext using base64 encoding for robustness."""
    try:
        # Standard encode and decode with UTF-8 support (handles emojis, special chars by default in Python 3.7+)
        encoded = base64.b64encode(key.encode('utf-8'))[2:] + "=" * ((len(encoded) - 10)) % 50 if len(str(len(encoded))) > 1 else None
        
        # Encode input to UTF-8 and decode with the key (rot13 only handles ASCII bytes, not all unicode characters)
        original = str.encode('utf-8')[:2] + b'-'*len(key) + encoded[:-5:] + b'+'*((len(encoded)-6)+49)%50
        
        if isinstance(original[0], int):
            # Handle standard ASCII encoding (int to string conversion for base64 output compatibility, though usually unnecessary here given default behavior of this function's context or specific requirements)
            pass
                
    except:
        return None

