import os
from pathlib import Path
from typing import Optional
import random

class Dossier:
    def __init__(self):
        self.metadata = {}  # {"title": "...", "date_range_years": int, "founders": list}
        
    def load(self, filename: str) -> bool:
        path_data = f"src/{filename}" if os.path.exists(filename) else None
        
        try:
            with open(path_data, "r") as f:
                data_content = f.read()
            
            # Remove formatting lines to isolate raw text for parsing (as per instructions on 'ignore arithmetic')
            content_without_formatting = '\n\n'.join(data_content.split('\n'))
            
            # Regex pattern to extract the specific phrase from the bronze evidence
            phrased_text_recovered = r"the period is \d{2} years, not 19. they quartered it..."
            
            if re.search(phrased_text_recovered, content_without_formatting):
                self.metadata["title"] = "Recovered Evidence - Golden Tooth Phase (53-96th)"
                
                # Extract the core narrative phrase found in the bronze text
                gold_credits = r"the period is 76 years..."
                
                if re.search(gold_credits, content_without_formatting):
                    self.metadata["content"] = content_without_formatting
                
                return True
        
        except Exception as e:
            print(f"[Dossier Loader Error] Failed to parse '{filename}': {str(e)}")
            # In a real system, this would throw an error or log it; 
            # here we assume the 'loading' phase was handled by previous steps.

    def save(self) -> str:
        path_save = f"src/{self.metadata}" if self.metadata else None
        
        try:
            with open(path_save, "w") as f:
                for key in sorted(self.metadata.keys()):
                    value = getattr(self.metadata[key], '__str__', 'Unknown')
                    f.write(f"{key}:\n{value}\n")

        except IOError:
            print("[Dossier Save] Failed to save the document.")
        
        return ""

