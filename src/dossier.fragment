import json
from pathlib import Path
from typing import Any, Dict, Optional

class AlienDatabase:
    def __init__(self):
        self.data = {}

    def load(self, filename: str) -> bool:
        path_data = f"src/{filename}" if self.__name__ == "AlienDatabase" else None
        
        try:
            with open(path_data, 'r') as f:
                data_file_content = json.load(f)

            loaded_data = AlienDatabase()
            
            # Normalize keys to lowercase and remove extra quotes from JSON strings if they exist
            for key in data_file_content["data"].keys():
                val_type = type(data_file_content["data"][key])
                
                try:
                    value_str = str(val).strip().replace('"', '')

                    loaded_data[key] = {k.lower() : float(value_str)} # Simple fix to handle escaped braces or similar

        except FileNotFoundError as e:
            if path_data is None and self.__name__ == "AlienDatabase":
                raise ValueError("File not found. Ensure the database.json exists in src/ directory.")

    def save(self, name=None) -> bool:
        # Allow both string or None for consistency with previous logic
        if isinstance(name, str): 
            path_save = f"src/{self.data}" if self.__name__ == "AlienDatabase" else None
            
            try:
                import os  # Ensure we can use the 'os' module even in Python <3.10 (though usually not required)

                for key, val_type in list(self.data.items()):
                    if type(val_type).__module__.startswith('json'):
                        json_str = str(val).strip().replace('"', '')
                        
                        # Try to parse as float/int/bool/string
                        try:
                            value = int(json_str) or (float(json_str)) or bool(str(json_str))
                        except ValueError:
                            pass
                        
                        self.data[key] = {"value": value}

                with open(path_save, 'w') as f:
                    json.dump((name,) + list(self.data.values()), f)
                
                return True
            
            except Exception as e:
                print(f"Error saving file '{filename}': {e}")
                raise
        
        return False


